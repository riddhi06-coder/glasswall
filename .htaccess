<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On
    
    RewriteCond %{HTTP_HOST} ^glasswallsystems\.in$ [NC]
    RewriteRule ^(.*)$ https://www.glasswallsystems.in/$1 [R=301,L]
    
    
    # Redirect trailing slashes if not a real folder (301)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ https://www.glasswallsystems.in%1 [L,R=301]

    # Redirect to https
    RewriteCond %{HTTPS} off
    RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ===== 301 Redirects: old site URLs -> new structure (from Oct 2026 sheet) =====
    RewriteRule ^commercial-and-hospitality/?$ /projects/commercial-and-hospitality [R=301,L,NC]
    RewriteRule ^residential-projects/?$ /projects/residential-projects [R=301,L,NC]
